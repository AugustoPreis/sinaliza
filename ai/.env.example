# Exporte no processo; este arquivo não é carregado automaticamente.
NODE_ENV=development
AI_MODE=disabled
AI_HOST=127.0.0.1
AI_PORT=3001
AI_SERVICE_TOKEN=
# Ative dynamic para a classificação final. Pesos locais são obrigatórios.
# AI_EMBEDDINGS_CACHE_DIR=/caminho/cache-transformers
# CLI npm run predict: cookies da sessão real, nunca versionar.
BACKEND_API_URL=http://127.0.0.1:3000/api/v1
BACKEND_SESSION_COOKIE=
# Opções abaixo são exclusivas de experimentos históricos (mock/trained).
# AI_MODEL_PATH=models/demo/tfidf.json
# AI_MODEL_TYPE=tfidf
# AI_SECTOR_SOURCE=mock-file
