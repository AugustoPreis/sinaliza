# Referência: exporte as variáveis no processo; o serviço não carrega este arquivo.
NODE_ENV=development
AI_MODE=disabled
AI_HOST=127.0.0.1
AI_PORT=3001
AI_SERVICE_TOKEN=
AI_MODEL_PATH=models/demo/tfidf.json
BACKEND_API_URL=http://127.0.0.1:3000/api/v1
# Valor do cookie access_token recebido no login do backend.
BACKEND_API_TOKEN=
BACKEND_TIMEOUT_MS=3000
# Tipo do modelo: tfidf ou minilm.
AI_MODEL_TYPE=tfidf
# Produção/integração: backend. mock-file somente em AI_MODE=mock.
AI_SECTOR_SOURCE=backend
