{{#> base preheader=body}}
  <p class="email-heading" style="margin: 0 0 16px; font-size: 17px; font-weight: 600; color: #111827;">{{greeting}}</p>
  <p style="margin: 0 0 28px;">{{body}}</p>

  <div style="text-align: center; margin: 0 0 28px;">
    {{> button url=resetUrl label=buttonLabel}}
  </div>

  <p class="email-muted" style="margin: 0 0 6px; font-size: 13px; color: #6b7280;">{{linkFallback}}</p>
  <p style="margin: 0 0 28px; font-size: 13px; word-break: break-all;">
    <a href="{{resetUrl}}" class="email-link" style="color: #2563eb; text-decoration: underline;">{{resetUrl}}</a>
  </p>

  <p class="email-muted" style="margin: 0; font-size: 13px; color: #6b7280;">{{footer}}</p>
{{/base}}
